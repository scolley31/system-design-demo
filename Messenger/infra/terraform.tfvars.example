# 複製成 terraform.tfvars 後依需求調整。
project = "messenger"
region  = "ap-northeast-1"
azs     = ["ap-northeast-1a", "ap-northeast-1c"]

# 成本控制（demo 預設）
single_nat_gateway = true
ec2_instance_type  = "t4g.small"
etcd_instance_type = "t4g.micro"
etcd_node_count    = 1 # demo SPOF；目前只允許 1（production 3 台跨 AZ，見 README）

# gateway / pubsub 兩組 ASG 各自的容量（同一映像，靠 ROLE env 區分角色）
gateway_asg_desired_capacity = 2
pubsub_asg_desired_capacity  = 2

# App 設定（app/config.py）
num_shards       = 64
lease_ttl_s      = 5
max_participants = 100
allow_debug      = false # true → 開 /api/debug/kill（demo failover 用，對外環境別開）
auth_enabled     = false # true → /ws 必須帶 ?token=<Cognito id token>

# WAF per-IP（每 5 分鐘）
waf_rate_limit_api    = 300
waf_rate_limit_global = 2000

alert_email = "you@example.com"
github_repo = "scolley31/system-design-demo"
